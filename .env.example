# Copy to .env and change the password before running `docker compose up -d`.
# docker compose reads this file for ${...} substitution; the Python scripts read it via python-dotenv.

# --- Postgres (used by n8n; docs/postgres.md assumes these values) ---
POSTGRES_USER=ai
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n
TZ=UTC

# --- RAG scripts (ingest.py / ask.py) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docs
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2
DOCS_DIR=docs
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBED_BATCH=64
TOP_K=4
